OPENROUTER_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_MODEL=deepseek/deepseek-v4-flash
# Optional Fernet key (or any string). If unset, auto-created at .cocoder/data/master.key
COCODER_SECRETS_KEY=
# Set true when serving over HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
FRONTEND_URL=http://localhost:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/settings/github/oauth/callback
GITHUB_OAUTH_SCOPES=read:user user:email repo
# LangGraph steps per agent invoke (search/read/edit/structured-output each count).
AGENT_RECURSION_LIMIT=12
